
[Desktop Entry]
Type=Service
MimeType=inode/directory;
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
X-KDE-Submenu=Krokiet
X-KDE-Submenu[ru]=Krokiet
Icon=krokiet
Actions=duplicates;empty-folders;biggest-files;empty-files;temporary;similar-images;similar-videos;same-music;invalid-symlinks;broken-files;bad-extensions;bad-names;exif-remover;video-optimizer;

[Desktop Action duplicates]
Name=Find duplicates
Name[ru]=Поиск дубликатов
Exec=SLINT_BACKEND=winit-skia-opengl krokiet --tool duplicates --scan %f

[Desktop Action empty-folders]
Name=Find empty folders
Name[ru]=Поиск пустых папок
Exec=SLINT_BACKEND=winit-skia-opengl krokiet --tool empty-folders --scan %f

[Desktop Action biggest-files]
Name=Find biggest files
Name[ru]=Поиск самых больших файлов
Exec=SLINT_BACKEND=winit-skia-opengl krokiet --tool biggest-files --scan %f

[Desktop Action empty-files]
Name=Find empty files
Name[ru]=Поиск пустых файлов
Exec=SLINT_BACKEND=winit-skia-opengl krokiet --tool empty-files --scan %f

[Desktop Action temporary]
Name=Find temporary files
Name[ru]=Поиск временных файлов
Exec=SLINT_BACKEND=winit-skia-opengl krokiet --tool temporary --scan %f

[Desktop Action similar-images]
Name=Find similar images
Name[ru]=Поиск похожих изображений
Exec=SLINT_BACKEND=winit-skia-opengl krokiet --tool similar-images --scan %f

