Exec=SLINT_BACKEND=winit-skia-opengl krokiet --tool similar-videos --scan %f

[Desktop Action same-music]
Name=Find identical music
Name[ru]=Поиск одинаковой музыки
Exec=SLINT_BACKEND=winit-skia-opengl krokiet --tool same-music --scan %f

[Desktop Action invalid-symlinks]
Name=Find invalid symlinks
Name[ru]=Поиск некорректных символических ссылок
Exec=SLINT_BACKEND=winit-skia-opengl krokiet --tool invalid-symlinks --scan %f

[Desktop Action broken-files]
Name=Find broken files
Name[ru]=Поиск повреждённых файлов
Exec=SLINT_BACKEND=winit-skia-opengl krokiet --tool broken-files --scan %f

[Desktop Action bad-extensions]
Name=Find files with bad extensions
Name[ru]=Поиск файлов с неверными расширениями
Exec=SLINT_BACKEND=winit-skia-opengl krokiet --tool bad-extensions --scan %f

[Desktop Action bad-names]
Name=Find files with bad names
Name[ru]=Поиск файлов с некорректными именами
Exec=SLINT_BACKEND=winit-skia-opengl krokiet --tool bad-names --scan %f

[Desktop Action exif-remover]
Name=Remove EXIF
Name[ru]=Удаление метаданных EXIF
Exec=SLINT_BACKEND=winit-skia-opengl krokiet --tool exif-remover --scan %f

[Desktop Action video-optimizer]
Name=Optimize videos
Name[ru]=Оптимизация видео
Exec=SLINT_BACKEND=winit-skia-opengl krokiet --tool video-optimizer --scan %f
